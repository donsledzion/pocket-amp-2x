# This .gitignore file should be placed at the root of your Unity project.
#
# Recommended: Visual Studio / JetBrains Rider / Visual Studio Code

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive
/[Mm]emoryCaptures/

# Recorded assets can be large
/[Rr]ecordings/

# Asset store packages can be very large and should be downloaded per-user
# Uncomment if you want to skip tracking them
# /[Aa]ssets/[Aa]ssetStore[Pp]ackages/

# Crashlytics generated file
/Assets/StreamingAssets/google-services-desktop.json

# External editor files
/[Aa]ssets/Plugins/Android/assets/

# .collabignore if using Unity Collab
/.collabignore

# --- IDE Project Files ---

# Visual Studio
[Vv]s/
*.csproj
*.sln
*.suo
*.tmp
*.user
*.userosscache
*.sln.docindex.db
*.sln.viewstate

# JetBrains Rider
.idea/
*.sln.iml
*.idea.Winamp.dir/

# Visual Studio Code
.vscode/

# --- OS Specific Files ---

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# --- PlasticSCM ---
/plastic/


*.keystore
.utmp/
Assets/LocalizationTools/Resources/GeminiConfig.asset
