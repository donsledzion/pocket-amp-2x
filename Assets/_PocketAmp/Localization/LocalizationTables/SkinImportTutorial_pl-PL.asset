  m_TableData:
  - m_Id: 9046056960
    m_Localized: "Przep\u0119d\u017A!"
    m_Metadata:
      m_Items: []
  - m_Id: 3465949470720
    m_Localized: "\u015Awietnie! Twoja sk\xF3rka zosta\u0142a za\u0142adowana. Kliknij
      tu, by zamkn\u0105\u0107 okno."
    m_Metadata:
      m_Items: []
  - m_Id: 3417010331648
    m_Localized: "Pobieram... poczekaj chwil\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 3364883521536
    m_Localized: "Teraz zastosuj sk\xF3rk\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 3308566601728
    m_Localized: "O! Wybierz t\u0119 sk\xF3rk\u0119 z listy!"
    m_Metadata:
      m_Items: []
  - m_Id: 3246323130368
    m_Localized: "Wpisz tutaj np. 'Classic', aby znale\u017A\u0107 ulubion\u0105
      sk\xF3rk\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 3190081708032
    m_Localized: "Prze\u0142\u0105cz si\u0119 na przegl\u0105dark\u0119 sk\xF3rek
      online!"
    m_Metadata:
      m_Items: []
  - m_Id: 3125799804928
    m_Localized: Wybierz 'Open Skins Library'!
    m_Metadata:
      m_Items: []
  - m_Id: 3067213766656
    m_Localized: "Kliknij tutaj, aby otworzy\u0107 opcje!"
    m_Metadata:
      m_Items: []
  - m_Id: 3000075542528
    m_Localized: "Przep\u0119d\u017A!"
    m_Metadata:
      m_Items: []
  - m_Id: 151782457073664
    m_Localized: "Jestem Alpaccino i pomog\u0119 zmieni\u0107 sk\xF3rk\u0119 na co\u015B
      ciekawszego."
    m_Metadata:
      m_Items: []
  - m_Id: 151828212736000
    m_Localized: "W ka\u017Cdej chwili mo\u017Cesz si\u0119 mnie pozby\u0107 przyciskiem
      poni\u017Cej."
    m_Metadata:
      m_Items: []
